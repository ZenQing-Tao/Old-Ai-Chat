+name: Build APK
+
+on:
+  push:
+    branches: [ main ]
+  workflow_dispatch:
+
+jobs:
+  build:
+    runs-on: ubuntu-22.04
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Set up JDK 8
+        uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '8'
+
+      - name: Cache Android SDK
+        uses: actions/cache@v4
+        with:
+          path: ~/android-sdk
+          key: android-sdk-30.0.3-android-28-v1
+
+      - name: Install Android SDK (build-tools 30.0.3 + platform 28)
+        run: |
+          set -e
+          SDK=$HOME/android-sdk
+          if [ ! -x "$SDK/build-tools/30.0.3/aapt" ]; then
+            mkdir -p "$SDK/cmdline-tools"
+            cd "$SDK"
+            curl -sSLo cmdline.zip https://dl.google.com/android/repository/commandlinetools-linux-9477386_latest.zip
+            unzip -q cmdline.zip -d "$SDK/cmdline-tools"
+            rm -f cmdline.zip
+            mv "$SDK/cmdline-tools/cmdline-tools" "$SDK/cmdline-tools/latest"
+            yes | "$SDK/cmdline-tools/latest/bin/sdkmanager" --sdk_root="$SDK" --licenses > /dev/null || true
+            "$SDK/cmdline-tools/latest/bin/sdkmanager" --sdk_root="$SDK" "platform-tools" "build-tools;30.0.3" "platforms;android-28"
+          fi
+          echo "sdk.dir=$SDK" > app/local.properties
+
+      - name: Build unsigned-ish APK via legacy ant-layout script
+        run: |
+          chmod +x app/build.sh
+          bash app/build.sh
+
+      - name: Rename artifact
+        run: |
+          mkdir -p out
+          SHORT=$(echo "$GITHUB_SHA" | cut -c1-7)
+          cp app/bin/OAC_1.4.apk "out/OAC-root-shell-$SHORT.apk"
+          ls -lh out
+
+      - name: Upload APK
+        uses: actions/upload-artifact@v4
+        with:
+          name: OAC-root-shell-apk
+          path: out/*.apk
+          if-no-files-found: error
