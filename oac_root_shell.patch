+        et.setGravity(android.view.Gravity.TOP | android.view.Gravity.LEFT);
+        et.setText(mSettings.getShellWhitelist());
+        et.setHint(R.string.set_shell_whitelist_hint);
+
+        AlertDialog.Builder b = new AlertDialog.Builder(this);
